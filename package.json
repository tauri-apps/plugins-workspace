    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "3.0.1",
    "prettier": "3.6.2",
    "rollup": "4.45.1",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
